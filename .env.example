# Use Replit Secrets. Never commit actual credentials.
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
DEFAULT_AI_PROVIDER=demo
